@{
}
@model List<Movie>

<h1>Movie List</h1>

<table class="table table-bordered">
    <thead>
        <tr class="fw-bold">
            <td>Category</td>
	        <td>Title</td>
	        <td>Year</td>
            <td>Director</td>
	        <td>Rating</td>
            <td>Edited</td>
	        <td>Lent to</td>
            <td>Copied to Plex</td>
	        <td>Notes</td>
        </tr>
    </thead>

    @foreach (var x in Model) 
    {
        <tbody>
            <tr>
                <td>@x.Category</td>
	            <td>@x.Title</td>
	            <td>@x.Year</td>
	            <td>@x.Director</td>
                <td>@x.Rating</td>
	            <td>@x.Edited</td>
                <td>@x.LentTo</td>
                @* <td>x.CopiedToPlex</td> *@
                <td>@x.Notes</td>
            </tr>
        </tbody>
    }
</table>